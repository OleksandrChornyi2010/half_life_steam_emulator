{
    "version": 8,
    "configurePresets": [
        {
            "name": "base-linux",
            "hidden": true,
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/linux/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "/usr/bin/gcc",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++",
                "CMAKE_FIND_ROOT_PATH": "/opt/protobuf-32",
                "Protobuf_PROTOC_EXECUTABLE": "/opt/protobuf-32/bin/protoc",
                "CMAKE_FIND_ROOT_PATH_MODE_PROGRAM": "NEVER",
                "CMAKE_FIND_ROOT_PATH_MODE_LIBRARY": "ONLY",
                "CMAKE_FIND_ROOT_PATH_MODE_INCLUDE": "ONLY"
            }
        },
        {
            "name": "base-windows",
            "hidden": true,
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build/win/${presetName}",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "C:/Libraries/protobuf-32",
                "Protobuf_INCLUDE_DIR": "C:/Libraries/protobuf-32/include",
                "Protobuf_LIBRARY": "C:/Libraries/protobuf-32/lib/libprotobuf.lib",
                "Protobuf_PROTOC_EXECUTABLE": "C:/Libraries/protobuf-32/bin/protoc.exe"
            }
        },
        {
            "name": "base-mingw",
            "hidden": true,
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/mingw/${presetName}",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Windows",
                "CMAKE_FIND_ROOT_PATH": "/opt/protobuf-mingw32",
                "Protobuf_PROTOC_EXECUTABLE": "/opt/protobuf-32/bin/protoc",
                "CMAKE_FIND_ROOT_PATH_MODE_PROGRAM": "NEVER",
                "CMAKE_FIND_ROOT_PATH_MODE_LIBRARY": "ONLY",
                "CMAKE_FIND_ROOT_PATH_MODE_INCLUDE": "ONLY",
                "CMAKE_SHARED_LINKER_FLAGS": "-static-libgcc -static-libstdc++ -static",
                "CMAKE_EXE_LINKER_FLAGS": "-static-libgcc -static-libstdc++ -static"
            }
        },
        {
            "name": "linux-x86-debug",
            "displayName": "Linux x86 Debug (32-bit)",
            "inherits": "base-linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS": "-m32",
                "CMAKE_CXX_FLAGS": "-m32",
                "CMAKE_SHARED_LINKER_FLAGS": "-m32"
            }
        },
        {
            "name": "linux-x86-release",
            "displayName": "Linux x86 Release (32-bit)",
            "inherits": "base-linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_FLAGS": "-m32",
                "CMAKE_CXX_FLAGS": "-m32",
                "CMAKE_SHARED_LINKER_FLAGS": "-m32"
            }
        },
        {
            "name": "win-x86-debug",
            "displayName": "Windows x86 Debug (32-bit)",
            "inherits": "base-windows",
            "architecture": "Win32",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_PREFIX_PATH": "C:/Libraries/protobuf-32-debug",
                "Protobuf_INCLUDE_DIR": "C:/Libraries/protobuf-32-debug/include",
                "Protobuf_LIBRARY": "C:/Libraries/protobuf-32-debug/lib/libprotobufd.lib",
                "Protobuf_PROTOC_EXECUTABLE": "C:/Libraries/protobuf-32-debug/bin/protoc.exe"
            }
        },
        {
            "name": "win-x86-release",
            "displayName": "Windows x86 Release (32-bit)",
            "inherits": "base-windows",
            "architecture": "Win32",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "mingw-win-x86-debug",
            "displayName": "MinGW Windows x86 Debug (32-bit)",
            "inherits": "base-mingw",
            "cacheVariables": {
                "CMAKE_SYSTEM_PROCESSOR": "i686",
                "CMAKE_C_COMPILER": "/usr/bin/i686-w64-mingw32-gcc",
                "CMAKE_CXX_COMPILER": "/usr/bin/i686-w64-mingw32-g++",
                "CMAKE_RC_COMPILER": "/usr/bin/i686-w64-mingw32-windres",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "mingw-win-x86-release",
            "displayName": "MinGW Windows x86 Release (32-bit)",
            "inherits": "base-mingw",
            "cacheVariables": {
                "CMAKE_SYSTEM_PROCESSOR": "i686",
                "CMAKE_C_COMPILER": "/usr/bin/i686-w64-mingw32-gcc",
                "CMAKE_CXX_COMPILER": "/usr/bin/i686-w64-mingw32-g++",
                "CMAKE_RC_COMPILER": "/usr/bin/i686-w64-mingw32-windres",
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "base-build",
            "hidden": true,
            "targets": [ "steam_api" ],
            "environment": {
                "CMAKE_BUILD_PARALLEL_LEVEL": "$penv{NUMBER_OF_PROCESSORS}" 
            }
        },
        {
            "name": "linux-x86-debug",
            "displayName": "Build Linux x86 Debug",
            "inherits": "base-build",
            "configurePreset": "linux-x86-debug"
        },
        {
            "name": "linux-x86-release",
            "displayName": "Build Linux x86 Release",
            "inherits": "base-build",
            "configurePreset": "linux-x86-release"
        },
        {
            "name": "win-x86-debug",
            "displayName": "Build Windows x86 Debug",
            "inherits": "base-build",
            "configurePreset": "win-x86-debug",
            "configuration": "Debug"
        },
        {
            "name": "win-x86-release",
            "displayName": "Build Windows x86 Release",
            "inherits": "base-build",
            "configurePreset": "win-x86-release",
            "configuration": "Release"
        },
        {
            "name": "mingw-win-x86-debug",
            "displayName": "Build MinGW x86 Debug",
            "inherits": "base-build",
            "configurePreset": "mingw-win-x86-debug"
        },
        {
            "name": "mingw-win-x86-release",
            "displayName": "Build MinGW x86 Release",
            "inherits": "base-build",
            "configurePreset": "mingw-win-x86-release"
        }
    ]
}